<h1>Settle Up</h1>

<% if @payment.errors.any? %>
  <div style="color:red;">
    <ul>
      <% @payment.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @payment do |f| %>
  <div>
    <%= f.label :paid_to_id, "Pay to" %><br/>
    <%= f.collection_select :paid_to_id, @users, :id, :name, prompt: "Select a friend" %>
  </div>

  <div>
    <%= f.label :amount %><br/>
    <%= f.number_field :amount, step: "0.01" %>
  </div>

  <div>
    <%= f.label :notes %><br/>
    <%= f.text_area :notes, rows: 3 %>
  </div>

  <br/>
  <%= f.submit "Record Payment" %>
<% end %>

<hr/>
<p>
  <%= link_to "Back to Dashboard", root_path %>
</p>
