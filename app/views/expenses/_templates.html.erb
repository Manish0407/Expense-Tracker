<template id="participant-template">
  <div class="nested-row">
    <div class="nested-fields">
      <label class="mini-label">Participant</label>
      <select class="input" name="expense[expense_participants_attributes][NEW_INDEX][user_id]">
        <% @users.each do |u| %>
          <option value="<%= u.id %>"><%= u.name %></option>
        <% end %>
      </select>
    </div>

    <button type="button" class="btn danger" data-action="click->nested#remove">Remove</button>
  </div>
</template>

<template id="item-template">
  <div class="nested-card item">
    <div class="nested-card-header">
      <div>
        <div class="nested-title">Item</div>
        <div class="muted">Add name, amount and split type</div>
      </div>

      <button type="button" class="btn danger" data-action="click->nested#remove">Remove item</button>
    </div>

    <div class="nested-grid">
      <div class="nested-fields">
        <label class="mini-label">Name</label>
        <input class="input" type="text" name="expense[expense_items_attributes][NEW_INDEX][name]" />
      </div>

      <div class="nested-fields">
        <label class="mini-label">Amount</label>
        <input class="input" type="number" step="0.01" name="expense[expense_items_attributes][NEW_INDEX][amount]" />
      </div>

      <div class="nested-fields">
        <label class="mini-label">Split type</label>
        <select
          class="input"
          name="expense[expense_items_attributes][NEW_INDEX][split_type]"
          data-action="change->nested#toggleAssignments"
        >
          <option value="shared" selected>shared</option>
          <option value="assigned">assigned</option>
        </select>

        <p class="muted" style="margin-top:6px;">
          Shared = split equally among participants. Assigned = full amount to one person.
        </p>
      </div>
    </div>

    <div class="assignment-ui" data-nested-target="assignmentUI">
      <div class="nested-subheader">
        <div class="nested-title">Assignments</div>
        <button type="button" class="btn" data-action="click->nested#addAssignment">+ Add assignment</button>
      </div>

      <div class="assignments" data-nested-target="assignments"></div>
    </div>
  </div>
</template>

<template id="assignment-template">
  <div class="nested-row assignment-row">
    <div class="nested-fields">
      <label class="mini-label">Person</label>
      <select class="input" name="expense[expense_items_attributes][ITEM_INDEX][expense_item_assignments_attributes][NEW_INDEX][user_id]">
        <% @users.each do |u| %>
          <option value="<%= u.id %>"><%= u.name %></option>
        <% end %>
      </select>
    </div>

    <div class="nested-fields">
      <label class="mini-label">Share amount (optional)</label>
      <input
        class="input"
        type="number"
        step="0.01"
        placeholder="Leave blank for equal split"
        name="expense[expense_items_attributes][ITEM_INDEX][expense_item_assignments_attributes][NEW_INDEX][share_amount]" />
    </div>

    <button type="button" class="btn danger" data-action="click->nested#remove">Remove</button>
  </div>
</template>