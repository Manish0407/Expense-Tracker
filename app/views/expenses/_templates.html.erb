<template id="participant-template">
  <div class="participant">
    <select name="expense[expense_participants_attributes][NEW_INDEX][user_id]">
      <% @users.each do |u| %>
        <option value="<%= u.id %>"><%= u.name %></option>
      <% end %>
    </select>
    <button type="button" data-action="click->nested#remove">Remove</button>
  </div>
</template>

<template id="item-template">
  <div class="item" style="border:1px solid #ddd; padding:10px; margin:10px 0;">
    <label>Name</label><br/>
    <input type="text" name="expense[expense_items_attributes][NEW_INDEX][name]" /><br/>

    <label>Amount</label><br/>
    <input type="number" step="0.01" name="expense[expense_items_attributes][NEW_INDEX][amount]" /><br/>

    <label>Split type</label><br/>
    <select name="expense[expense_items_attributes][NEW_INDEX][split_type]">
      <option value="assigned">assigned</option>
      <option value="shared">shared</option>
    </select>

    <h4>Assignments</h4>
    <div class="assignments" data-nested-target="assignments"></div>

    <button type="button" data-action="click->nested#addAssignment">Add assignment</button>
    <button type="button" data-action="click->nested#remove">Remove item</button>
  </div>
</template>

<template id="assignment-template">
  <div class="assignment">
    <select name="expense[expense_items_attributes][ITEM_INDEX][expense_item_assignments_attributes][NEW_INDEX][user_id]">
      <% @users.each do |u| %>
        <option value="<%= u.id %>"><%= u.name %></option>
      <% end %>
    </select>

    <input type="number" step="0.01"
      placeholder="share_amount (optional for unequal)"
      name="expense[expense_items_attributes][ITEM_INDEX][expense_item_assignments_attributes][NEW_INDEX][share_amount]" />

    <button type="button" data-action="click->nested#remove">Remove</button>
  </div>
</template>
