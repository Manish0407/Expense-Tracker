<div class="container">
  <div class="page-title">
    <h1>All Expenses</h1>
    <div>
      <%= link_to "Share New Expense", new_expense_path, class: "btn primary" %>
    </div>
  </div>

  <% if @expenses.any? %>
    <div class="card">
      <div class="table-wrapper">
        <table class="modern-table">
          <thead>
            <tr>
              <th>Description</th>
              <th>Paid By</th>
              <th>Total</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% @expenses.each do |expense| %>
              <tr>
                <td>
                  <div class="name">
                    <%= expense.description.presence || "No description" %>
                  </div>
                </td>

                <td>
                  <span class="muted"><%= expense.paid_by.name %></span>
                </td>

                <td>
                  <strong class="amount"><%= expense.total_amount %></strong>
                </td>

                <td>
                  <span class="muted"><%= expense.spent_on %></span>
                </td>

                <td>
                  <%= link_to "View", expense_path(expense), class: "btn small" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card empty">
      <h2>No expenses yet</h2>
      <p class="muted">Start by sharing your first expense.</p>
      <%= link_to "Share Expense", new_expense_path, class: "btn primary" %>
    </div>
  <% end %>
</div>
