<h1>All Expenses</h1>

<p>
  <%= link_to "Share New Expense", new_expense_path %>
</p>

<% if @expenses.any? %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Description</th>
        <th>Paid By</th>
        <th>Total Amount</th>
        <th>Date</th>
        <th>View</th>
      </tr>
    </thead>

    <tbody>
      <% @expenses.each do |expense| %>
        <tr>
          <td><%= expense.description %></td>
          <td><%= expense.paid_by.name %></td>
          <td>
            <%= expense.total_amount %>
          </td>
          <td><%= expense.spent_on %></td>
          <td>
            <%= link_to "Show", expense_path(expense) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No expenses yet.</p>
<% end %>
