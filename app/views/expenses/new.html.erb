<h1>Share an Expense</h1>

<% if @expense.errors.any? %>
  <div style="color:red;">
    <ul>
      <% @expense.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= render "templates" %>

<%= form_with model: @expense, data: { controller: "nested" } do |f| %>
  <div>
    <%= f.label :paid_by_id, "Paid by" %><br/>
    <%= f.collection_select :paid_by_id, @users, :id, :name %>
  </div>

  <div>
    <%= f.label :description %><br/>
    <%= f.text_field :description %>
  </div>

  <div>
    <%= f.label :spent_on %><br/>
    <%= f.date_field :spent_on %>
  </div>

  <div>
    <%= f.label :tax_amount, "Tax (split equally among participants)" %><br/>
    <%= f.number_field :tax_amount, step: "0.01" %>
  </div>

  <hr/>

  <h3>Participants</h3>
  <div data-nested-target="participants"></div>
  <button type="button" data-action="click->nested#addParticipant">Add participant</button>

  <hr/>

  <h3>Items</h3>
  <div data-nested-target="items"></div>
  <button type="button" data-action="click->nested#addItem">Add item</button>

  <br/><br/>
  <%= f.submit "Create Expense" %>
<% end %>
