<div class="container">
  <div class="page-title">
    <h1>Share an Expense</h1>
  </div>

  <% if @expense.errors.any? %>
    <div class="card" style="border:1px solid #fca5a5; background:#fef2f2;">
      <h2 style="color:#b91c1c;">Please fix the following errors:</h2>
      <ul class="list">
        <% @expense.errors.full_messages.each do |msg| %>
          <li style="color:#b91c1c;"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "templates" %>

  <%= form_with model: @expense, class: "card form-card", id: "expense-form" do |f| %>
    <div class="form-grid">

      <div class="form-group">
        <%= f.label :paid_by_id, "Paid by" %>
        <%= f.collection_select :paid_by_id, @users, :id, :name, {}, class: "input" %>
      </div>

      <div class="form-group">
        <%= f.label :description %>
        <%= f.text_field :description, class: "input" %>
      </div>

      <div class="form-group">
        <%= f.label :spent_on %>
        <%= f.date_field :spent_on, class: "input" %>
      </div>

      <div class="form-group">
        <%= f.label :tax_amount, "Tax (split equally among participants)" %>
        <%= f.number_field :tax_amount, step: "0.01", class: "input" %>
      </div>

    </div>

    <hr class="divider"/>

    <div class="section">
      <h2>Participants</h2>
      <div id="participants"></div>
      <button type="button" id="add-participant" class="btn">+ Add participant</button>
    </div>

    <hr class="divider"/>

    <div class="section">
      <h2>Items</h2>
      <div id="items"></div>
      <button type="button" id="add-item" class="btn">+ Add item</button>
    </div>

    <div style="margin-top:20px;">
      <%= f.submit "Create Expense", class: "btn primary" %>
    </div>

  <% end %>
</div>
