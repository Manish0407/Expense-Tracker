<h1><%= @user.name %></h1>
<p><%= @user.email %></p>

<hr/>

<h2>Expenses paid by <%= @user.name %></h2>

<% if @expenses.any? %>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Description</th>
        <th>Total</th>
        <th>Date</th>
        <th>View</th>
      </tr>
    </thead>
    <tbody>
      <% @expenses.each do |exp| %>
        <tr>
          <td><%= exp.description %></td>
          <td><%= exp.total_amount %></td>
          <td><%= exp.spent_on %></td>
          <td><%= link_to "Show", expense_path(exp) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No expenses created by this user yet.</p>
<% end %>

<hr/>
<p>
  <%= link_to "Back to users", users_path %> |
  <%= link_to "Dashboard", root_path %>
</p>
